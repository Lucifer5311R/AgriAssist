<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@id/navigation_home">

    <fragment
        android:id="@+id/navigation_home"
        android:name="com.example.agriassist.HomeFragment"
        android:label="Home" />
        
    <fragment
        android:id="@+id/navigation_plants"
        android:name="com.example.agriassist.PlantsFragment"
        android:label="Plants">
        <action
            android:id="@+id/action_plants_to_detail"
            app:destination="@id/plantDetailFragment" />
    </fragment>

    <fragment
        android:id="@+id/navigation_diary"
        android:name="com.example.agriassist.DiaryFragment"
        android:label="Diary" />

    <fragment
        android:id="@+id/navigation_account"
        android:name="com.example.agriassist.AccountFragment"
        android:label="Account" />

    <fragment
        android:id="@+id/navigation_camera"
        android:name="com.example.agriassist.CameraFragment"
        android:label="Camera" />

    <fragment
        android:id="@+id/navigation_marketplace"
        android:name="com.example.agriassist.MarketplaceFragment"
        android:label="Market" />

    <fragment
        android:id="@+id/plantDetailFragment"
        android:name="com.example.agriassist.PlantDetailFragment"
        android:label="Plant Details" />
</navigation>